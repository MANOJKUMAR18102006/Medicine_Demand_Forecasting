# MedDemand Multi-Shop Platform Configuration
# Copy this file to .env and configure values for your environment.

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Database Configuration (Defaults to local SQLite backend/meddemand.db)
MEDDEMAND_DB_PATH=backend/meddemand.db

# Security & Authentication (Generate a 64+ char random string for production)
JWT_SECRET_KEY=replace-with-a-secure-random-jwt-secret-key-in-production

# CORS Configuration (Comma-separated origins allowed)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Environment (frontend/.env)
VITE_API_URL=http://localhost:8000
